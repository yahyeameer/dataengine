# Hermes agent configuration.
#
# Copy to `.env` on the agent host and fill in. This file is the whole contract
# between the VPS and the rest of the system -- there is no other configuration
# and no config file to deploy.
#
# On a developer machine you can leave SUPABASE_URL and SUPABASE_SECRET_KEY
# blank: the agent falls back to apps/web/.env.local so the two cannot drift
# apart after `supabase start` reissues the local keys. That fallback only
# looks inside this repository, so it never fires in production.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Your project URL. For hosted Supabase this is https://<ref>.supabase.co
SUPABASE_URL=

# The service-role / secret key. This bypasses RLS entirely, which is why the
# agent is the only component outside the web server that holds it, and why the
# host it lives on should not run anything else.
#
# Rotate it in the Supabase dashboard if it is ever pasted anywhere it should
# not be -- a chat message, a screenshot, a support ticket.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Models (optional)
#
# With neither key set the agent still parses, profiles, proposes, cleans,
# queries and reports. It simply writes the explanations from its rule engine
# instead of in prose. Nothing about a figure depends on a model.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

KIMI_API_KEY=
# KIMI_MODEL=kimi-k2-0905-preview
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Which provider handles which class of work. "reasoning" is proposal
# explanation and question planning; "drafting" is narrative prose, where the
# cheaper model is usually indistinguishable. If the named provider has no key,
# the agent uses whichever one does rather than refusing.
# HERMES_REASONING_PROVIDER=openai
# HERMES_DRAFTING_PROVIDER=openai

# -----------------------------------------------------------------------------
# Tuning (optional -- the defaults are correct for a single small VPS)
# -----------------------------------------------------------------------------

# Identifies this worker in the dashboard. Set it if you run more than one, so
# they do not share a heartbeat row. Defaults to hermes-<hostname>.
# HERMES_WORKER_ID=hermes-vps-01

# How long a claimed job is this worker's before another may take it. Raise it
# if you routinely process workbooks that take longer than five minutes; the
# only cost of a longer lease is a slower recovery after a hard crash.
# HERMES_LEASE_SECONDS=300

# HERMES_HEARTBEAT_SECONDS=30
# HERMES_POLL_SECONDS=3

# Matches the 50 MB limit on the raw storage bucket. Raise both together or
# neither, and remember the file is held in memory while it is parsed.
# HERMES_MAX_DOWNLOAD_BYTES=52428800

# HERMES_WORK_DIR=/tmp/hermes
# HERMES_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Context discipline (PRD section 8)
#
# The model never receives rows -- only schema, statistics and a few frequent
# values. These control that last part. Turning redaction off is a deliberate,
# visible act; leave it on unless you have a reason.
# -----------------------------------------------------------------------------

# HERMES_MAX_SAMPLE_VALUES=5
# HERMES_REDACT_SAMPLES=true

# Where to post when the model stops running (optional).
#
# Leave blank and nothing changes: degradation is still logged by the worker and
# still shown in the dashboard banner. Setting it adds the out-of-band nudge,
# which is the only one that reaches somebody who is not already logged in.
#
# Accepts a Slack or Discord incoming webhook, or anything that takes JSON --
# the payload carries `text` and `content` with the same sentence so all three
# work without an adapter.
#
# Edge-triggered: one message when the fault starts, one when it clears. A
# lasting fault does not re-send, because the third identical alert is where
# somebody mutes the channel.
# HERMES_ALERT_WEBHOOK_URL=

# How often to re-read the degradation view. Ten minutes by default -- this is a
# slow-moving condition and a warning repeated twice a minute is one people
# learn to scroll past.
# HERMES_HEALTH_CHECK_SECONDS=600

# -----------------------------------------------------------------------------
# The customer -> Kanban bridge (off by default)
#
# Turns on the `kanban_report` job kind: a customer's report is produced by the
# internal Kanban chain (supervisor -> analyst -> reporter -> verifier) and the
# verified artefact is carried back into agent_jobs by this worker.
#
# Off means off. With HERMES_KANBAN_ENABLED unset the worker does not announce
# the capability, so a job of that kind sits queued and visible rather than
# being claimed and failed. The web app has its own switch
# (KANBAN_BRIDGE_ENABLED in apps/web/.env); both have to be set, on purpose, on
# two hosts.
#
# Before the first customer job, on the agent host:
#     python -m hermes.kanban --probe
# It runs every argument list this worker builds, read-only, and prints what the
# CLI accepted. A renamed flag is a five-second finding there and a mystery
# three minutes into a chain.
# -----------------------------------------------------------------------------

# HERMES_KANBAN_ENABLED=false

# The CLI, as a path *inside the container it runs in*.
# HERMES_KANBAN_COMMAND=/opt/hermes/.venv/bin/hermes

# How this worker reaches that CLI.
#
# The board lives inside the agent's container and the worker in its own, so on
# the Docker deployment the CLI is run there over the exec API -- through the
# socket proxy that docker-compose.yml defines, never against the socket
# directly. Mounting the socket into this container would hand root on the host
# to the process holding the Supabase service key.
#
# Leave both blank on the systemd deployment, where the worker runs beside the
# CLI and HERMES_KANBAN_COMMAND is simply `hermes`.
# HERMES_KANBAN_DOCKER_HOST=http://kanban-socket-proxy:2375
# HERMES_KANBAN_CONTAINER=hermes-agent-bwlq-hermes-agent-1
# HERMES_KANBAN_CONTAINER_USER=hermes

# HERMES_KANBAN_BOARD=dataengine
# HERMES_KANBAN_TIMEOUT_SECONDS=120

# Which Hermes profile takes each card, from /opt/data/profiles on the agent.
# HERMES_KANBAN_SUPERVISOR=dataengine-supervisor
# HERMES_KANBAN_ANALYST=dataengine-analyst
# HERMES_KANBAN_REPORTER=dataengine-reporter
# HERMES_KANBAN_VERIFIER=dataengine-supervisor

# One board check per claim, then the job goes back on the queue. Polling faster
# than the dispatcher's one-minute sweep only spends docker exec calls.
# HERMES_KANBAN_POLL_SECONDS=30
# A blocked card is waiting for a person, and people are not thirty seconds.
# HERMES_KANBAN_BLOCKED_POLL_SECONDS=300

# What actually bounds a bridged job -- not max_attempts, which a deferral gives
# back. A healthy four-card chain measured about ten minutes.
# HERMES_KANBAN_DEADLINE_SECONDS=3600
# A blocked run gets a working day, so a card blocked at five o'clock is still
# recoverable the next morning.
# HERMES_KANBAN_BLOCKED_DEADLINE_SECONDS=86400

# How long the input link handed to the board stays valid.
# HERMES_KANBAN_INPUT_URL_TTL_SECONDS=7200
# How often an idle worker stops the cards of a job the customer cancelled.
# HERMES_KANBAN_SWEEP_SECONDS=300
# Passed to the board as --max-runtime: the dispatcher SIGTERMs a card's worker
# that exceeds it. A second ceiling under the run deadline, enforced by the side
# that can actually stop a running turn.
# HERMES_KANBAN_CARD_MAX_RUNTIME=20m
