# Copy to .env beside docker-compose.yml, then `chmod 600 .env`.
#
# Distinct from .env.example, which documents local development: this file adds
# the variables the deployed app needs and development does not, and is read by
# compose rather than by Next.

# --- Supabase -------------------------------------------------------------
# Both are public: they are compiled into the browser bundle either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS -- treat it as a database password.
SUPABASE_SECRET_KEY=

# --- Hermes Agent ---------------------------------------------------------
# Confirmed on srv1927440: the webhook adapter is the Generic Webhook V2 one on
# port 8644. Port 4860 is the public Hermes dashboard -- do not point this at it.
HERMES_NETWORK=hermes-agent-bwlq_default

# BASE url, no path. route.ts appends /webhooks/ask itself, so a value ending in
# /webhooks/ask posts to /webhooks/ask/webhooks/ask and 404s every question.
#
# The literal IP is what the Hermes docs specify, and it works because both
# containers sit on hermes-agent-bwlq_default. Be aware that Docker reassigns
# container IPs on recreate: if questions start failing with "could not be
# reached" after Hostinger redeploys that application, this is the line to
# check. `http://hermes-agent:8644` -- the compose service alias -- is the
# equivalent address that survives a recreate, if you would rather not have to.
HERMES_WEBHOOK_URL=http://172.16.0.2:8644

# Confirmed against this installation's `hermes-webhook-integrations` skill:
# HMAC-SHA256 over the exact raw request body, sent as
#   X-Hub-Signature-256: sha256=<hexdigest>
# alongside X-GitHub-Event. No timestamp participates in the digest.
#
# `v2` switches to the Generic Webhook V2 adapter instead, if a future gateway
# runs one. A gateway expecting one scheme rejects the other with a 401 that
# looks exactly like a wrong secret, so change this only on evidence.
HERMES_WEBHOOK_SIGNING=github

# The gateway route jobs are pushed to. A Hermes subscription's name IS its URL:
# `hermes webhook subscribe dataengine-job` creates /webhooks/dataengine-job.
# This must match that name exactly, or every job 404s and the failure message
# says nothing about the name being wrong.
HERMES_JOB_ROUTE=dataengine-job

# The worker id jobs are claimed under. Must match the agent_workers row seeded
# by migration 20260821000015.
HERMES_WORKER_ID=hermes-agent

# How the agent reaches back with results. The web container's own service name
# on the compose network -- the callback never leaves the Docker bridge.
DATAENGINE_CALLBACK_URL=http://web:3100

# Must match the secret configured on the Hermes `ask` webhook route. Create the
# route and set its secret in Hermes FIRST -- this value is the second half of a
# pair, not something this app can define on its own.
#   openssl rand -hex 32
HERMES_WEBHOOK_SECRET=

# Per-route secrets, for the usual case where the gateway keys them to the route
# rather than to itself.
#
# One shared HERMES_WEBHOOK_SECRET can only be right for one route. On this
# installation it is the job route's, so job dispatch succeeded while every
# question returned `401 {"error": "Invalid signature"}` -- a failure that reads
# exactly like a wrong secret because that is what it is, for the other route.
# Set both and the ambiguity is gone. Left empty, `secretForRoute` falls back to
# the shared value and a single-secret gateway still works.
HERMES_ASK_SECRET=
HERMES_JOB_SECRET=

# Selects /p/<profile>/webhooks/<route>. Empty means the unprefixed path, which
# the gateway serves from its `default` profile. Set this only once the route's
# own JSON names the same profile: the adapter fails closed with a 404 when the
# two disagree.
HERMES_GATEWAY_PROFILE=

# The customer-facing half of the Kanban bridge, off unless set. Unset,
# /api/agent/jobs answers 404 for `kanban_report` and nothing else changes. The
# agent host has its own switch (HERMES_KANBAN_ENABLED) and both are required,
# deliberately -- opening this path is something you do on purpose, twice.
KANBAN_BRIDGE_ENABLED=

# --- Reverse proxy --------------------------------------------------------
# Traefik is already running on this VPS and owns 80/443. The app joins its
# network and configures routing with labels; do not start a second proxy.
#
#   docker network ls | grep -i traefik
#   docker inspect traefik-traefik-1 -f '{{json .Config.Cmd}}'
#
# That last command prints Traefik's entrypoint and certresolver names. Defaults
# below are the common ones, but they are conventions, not guarantees -- a wrong
# entrypoint means the router is created and never matches a request.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# The domain or subdomain whose A record points at this VPS.
WEB_DOMAIN=

# --- Resource caps --------------------------------------------------------
# Cores this box actually has: `nproc`. Both default to 0.5. Raise only with
# headroom -- sustained CPU gets the whole VPS throttled by 25% per hour.
WEB_CPUS=0.4

# Which build of the app this box runs. `latest` follows every push to main;
# CI overrides it per deploy with the commit SHA, which is what makes a rollback
# a tag rather than a rebuild:
#
#   WEB_TAG=<older-sha> docker compose up -d web
#
# Only images still on the box can be rolled back to. scripts/deploy-remote.sh
# keeps a week of them.
WEB_TAG=latest
