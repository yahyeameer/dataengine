# Copy to .env.local and fill in. For local development, run `supabase start`
# from the repository root and use the values it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: the service-role / secret key. Bypasses RLS, so it is read only
# inside server routes and server actions, and never reaches the browser bundle.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# The customer -> Kanban bridge (off by default)
#
# Allows a signed-in customer to ask for `kanban_report`, the job kind whose work
# is done by the internal multi-agent board. Unset, the route answers 404 for
# that kind and every other kind behaves exactly as before.
#
# The agent host has its own switch (HERMES_KANBAN_ENABLED in
# services/hermes/.env). Both are required, deliberately: opening this path is
# something you do on purpose, twice, rather than something that happens because
# one variable leaked into one environment file.
# -----------------------------------------------------------------------------

# KANBAN_BRIDGE_ENABLED=false
