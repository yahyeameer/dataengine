# application's TypeScript.
apps/web/src/lib/database.types.ts

# Build output, dependencies and lockfiles.
.next/
node_modules/
package-lock.json

# The Python service. Its own tooling formats its source; what Prettier finds
# in here is the virtualenv's vendored files and pytest's scratch directory,
# neither of which is ours to reformat.
services/hermes/.venv/
**/__pycache__/
**/.pytest_cache/

# Vendored agent skill packs. Not this repository's source, and they travel
# with their own formatting.
.agents/

# Deliberately malformed workbooks and the notes beside them. Several exist to
# prove the agent copes with broken input; tidying one deletes the thing it is
# testing.
fixtures/

# Prose is left alone for now. The Markdown here is written in long unwrapped
# paragraphs rather than to a measure, so Prettier would not rewrap it, but it
# would still touch list markers, emphasis characters and table padding across
# every document in the repository. That is a separate decision from agreeing
# on how the TypeScript is laid out, and this config was added to settle the
# TypeScript.
*.md
